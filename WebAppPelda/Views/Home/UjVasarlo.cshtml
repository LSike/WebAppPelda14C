@model WebAppPelda.Models.Vasarlo;

@{
    ViewData["Title"] = "Új vásárló rögzítése";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="mb-4">Vásárló adatai</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-controller="Home" asp-action="UjVasarlo" method="post" class="needs-validation" novalidate>


        <div class="mb-3">
            <label asp-for="Nev" class="form-label"></label>
            <input asp-for="Nev" class="form-control" placeholder="Minta János" />

        </div>

        <div class="mb-3">
            <label asp-for="Cim" class="form-label"></label>
            <input asp-for="Cim" class="form-control" placeholder="1051 Budapest, Fő tér 1." />

        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" placeholder="janos@example.com" />

        </div>

        <div class="mb-3">
            <label asp-for="Telefon" class="form-label"></label>
            <input asp-for="Telefon" class="form-control" placeholder="+36301234567" />

        </div>

        <div class="mb-3">
            <label asp-for="Pontszam" class="form-label"></label>
            <input asp-for="Pontszam" type="number" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary w-100">Mentés</button>
    </form>
</div>


@section Scripts {
    @* Kliensoldali validáció bekapcsolása ASP.NET Core-ban *@
	<!--<partial name="_ValidationScriptsPartial" />-->
}
